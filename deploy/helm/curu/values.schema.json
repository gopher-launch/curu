{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["image", "replicaCount", "service", "edge", "browserAuth", "runtime", "trust", "owner", "dataLifecycle", "database", "identity", "resources"],
  "properties": {
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "pullPolicy", "pullSecrets"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest"]}},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]},
        "pullSecrets": {
          "type": "array",
          "items": {"type": "string", "minLength": 1},
          "uniqueItems": true
        }
      }
    },
    "replicaCount": {"type": "integer", "minimum": 1, "maximum": 1},
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["port"],
      "properties": {"port": {"type": "integer", "minimum": 1024, "maximum": 65535}}
    },
    "edge": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "applicationHost", "identityHost", "publicOrigin", "publicPort", "tlsSecretName", "image", "service", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "applicationHost": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
        "identityHost": {"type": "string", "pattern": "^[a-z0-9](?:[a-z0-9.-]*[a-z0-9])?$"},
        "publicOrigin": {"type": "string", "pattern": "^https://[^/:]+:[0-9]+$"},
        "publicPort": {"type": "integer", "minimum": 1024, "maximum": 65535},
        "tlsSecretName": {"type": "string", "minLength": 1},
        "image": {"$ref": "#/definitions/containerImage"},
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port", "nodePort"],
          "properties": {
            "port": {"type": "integer", "minimum": 1024, "maximum": 65535},
            "nodePort": {"type": "integer", "minimum": 30000, "maximum": 32767}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {"$ref": "#/definitions/resourceList"},
            "limits": {"$ref": "#/definitions/resourceList"}
          }
        }
      }
    },
    "browserAuth": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "sessionSecret", "cookie", "resources"],
      "properties": {
        "image": {"$ref": "#/definitions/containerImage"},
        "sessionSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingName", "key"],
          "properties": {
            "existingName": {"type": "string"},
            "key": {"type": "string", "pattern": "^[A-Za-z0-9._-]+$"}
          }
        },
        "cookie": {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "expire", "refresh"],
          "properties": {
            "name": {"type": "string", "const": "__Host-curu_session"},
            "expire": {"type": "string", "pattern": "^[1-9][0-9]*[hm]$"},
            "refresh": {"type": "string", "pattern": "^[1-9][0-9]*[sm]$"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {"$ref": "#/definitions/resourceList"},
            "limits": {"$ref": "#/definitions/resourceList"}
          }
        }
      }
    },
    "runtime": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "publicOrigin", "trustedProxyCIDRs", "loginURL", "logoutURL", "shutdownTimeout", "readHeaderTimeout", "idleTimeout"],
      "properties": {
        "enabled": {"type": "boolean"},
        "publicOrigin": {"type": "string", "pattern": "^https://[^/]+$"},
        "trustedProxyCIDRs": {"type": "string"},
        "loginURL": {"type": "string", "pattern": "^(|https://.+)$"},
        "logoutURL": {"type": "string", "pattern": "^(|https://.+)$"},
        "shutdownTimeout": {"type": "string", "minLength": 1},
        "readHeaderTimeout": {"type": "string", "minLength": 1},
        "idleTimeout": {"type": "string", "minLength": 1}
      }
    },
    "trust": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile", "issuer", "audience", "jwksURL", "algorithms", "clockSkew", "maxLifetime", "jwksFetchTimeout", "jwksDefaultCacheTTL", "jwksUnknownKIDRefreshInterval"],
      "properties": {
        "profile": {"type": "string", "enum": ["rfc9068"]},
        "issuer": {"type": "string", "pattern": "^https://.+"},
        "audience": {"type": "string", "minLength": 1},
        "jwksURL": {"type": "string", "pattern": "^https://.+"},
        "algorithms": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "enum": ["RS256", "ES256"]}
        },
        "clockSkew": {"type": "string", "minLength": 1},
        "maxLifetime": {"type": "string", "minLength": 1},
        "jwksFetchTimeout": {"type": "string", "minLength": 1},
        "jwksDefaultCacheTTL": {"type": "string", "minLength": 1},
        "jwksUnknownKIDRefreshInterval": {"type": "string", "minLength": 1}
      }
    },
    "owner": {
      "type": "object",
      "additionalProperties": false,
      "required": ["issuer", "subject", "id"],
      "properties": {
        "issuer": {"type": "string", "pattern": "^https://.+"},
        "subject": {"type": "string", "minLength": 1},
        "id": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"}
      }
    },
    "dataLifecycle": {
      "type": "object",
      "additionalProperties": false,
      "required": ["migrate", "initialize", "activeDeadlineSeconds", "backoffLimit"],
      "properties": {
        "migrate": {"type": "boolean"},
        "initialize": {"type": "string", "enum": ["none", "seed", "empty"]},
        "activeDeadlineSeconds": {"type": "integer", "minimum": 30, "maximum": 900},
        "backoffLimit": {"type": "integer", "minimum": 0, "maximum": 3}
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundled", "external"],
      "properties": {
        "bundled": {"$ref": "#/definitions/bundledDatabase"},
        "external": {"$ref": "#/definitions/externalDatabase"}
      },
      "oneOf": [
        {
          "properties": {
            "bundled": {"properties": {"enabled": {"const": true}}},
            "external": {"properties": {"enabled": {"const": false}}}
          }
        },
        {
          "properties": {
            "bundled": {"properties": {"enabled": {"const": false}}},
            "external": {"properties": {"enabled": {"const": true}}}
          }
        }
      ]
    },
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["bundled", "external", "caTrust"],
      "properties": {
        "bundled": {"$ref": "#/definitions/bundledIdentity"},
        "external": {"$ref": "#/definitions/externalIdentity"},
        "caTrust": {
          "type": "object",
          "additionalProperties": false,
          "required": ["configMapName", "key"],
          "properties": {
            "configMapName": {"type": "string", "minLength": 1},
            "key": {"type": "string", "minLength": 1}
          }
        }
      },
      "oneOf": [
        {
          "properties": {
            "bundled": {"properties": {"enabled": {"const": true}}},
            "external": {"properties": {"enabled": {"const": false}}}
          }
        },
        {
          "properties": {
            "bundled": {"properties": {"enabled": {"const": false}}},
            "external": {"properties": {"enabled": {"const": true}}}
          }
        }
      ]
    },
    "resources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requests", "limits"],
      "properties": {
        "requests": {"$ref": "#/definitions/resourceList"},
        "limits": {"$ref": "#/definitions/resourceList"}
      }
    },
    "podAnnotations": {"type": "object"},
    "podLabels": {
      "type": "object",
      "propertyNames": {
        "not": {
          "enum": ["app.kubernetes.io/name", "app.kubernetes.io/instance", "app.kubernetes.io/component"]
        }
      }
    },
    "nodeSelector": {"type": "object"},
    "tolerations": {"type": "array"},
    "affinity": {"type": "object"}
  },
  "definitions": {
    "secretReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "key"],
      "properties": {
        "name": {"type": "string"},
        "key": {"type": "string", "minLength": 1}
      }
    },
    "bundledDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "credentialsSecret", "names", "service", "storage", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "digest", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1},
            "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest"]}},
            "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
            "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
          }
        },
        "credentialsSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingName"],
          "properties": {"existingName": {"type": "string"}}
        },
        "names": {
          "type": "object",
          "additionalProperties": false,
          "required": ["curuDatabase", "keycloakDatabase", "migrationRole", "initializerRole", "runtimeRole", "keycloakRole"],
          "properties": {
            "curuDatabase": {"$ref": "#/definitions/postgresDatabaseIdentifier"},
            "keycloakDatabase": {"$ref": "#/definitions/postgresDatabaseIdentifier"},
            "migrationRole": {"$ref": "#/definitions/postgresRoleIdentifier"},
            "initializerRole": {"$ref": "#/definitions/postgresRoleIdentifier"},
            "runtimeRole": {"$ref": "#/definitions/postgresRoleIdentifier"},
            "keycloakRole": {"$ref": "#/definitions/postgresRoleIdentifier"}
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["port"],
          "properties": {"port": {"type": "integer", "const": 5432}}
        },
        "storage": {
          "type": "object",
          "additionalProperties": false,
          "required": ["storageClassName", "size", "selectorLabels"],
          "properties": {
            "storageClassName": {"type": "string", "minLength": 1},
            "size": {"type": "string", "pattern": "^[1-9][0-9]*(Mi|Gi|Ti)$"},
            "selectorLabels": {"type": "object", "minProperties": 1, "additionalProperties": {"type": "string", "minLength": 1}}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {"$ref": "#/definitions/resourceList"},
            "limits": {"$ref": "#/definitions/resourceList"}
          }
        }
      }
    },
    "externalDatabase": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "host", "port", "curuDatabase", "keycloakDatabase", "initializerRole", "runtimeRole", "tls", "administrationSecret", "migrationSecret", "initializerSecret", "runtimeSecret", "keycloakSecret"],
      "properties": {
        "enabled": {"type": "boolean"},
        "host": {"type": "string"},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "curuDatabase": {"type": "string"},
        "keycloakDatabase": {"type": "string"},
        "initializerRole": {"$ref": "#/definitions/postgresRoleIdentifier"},
        "runtimeRole": {"$ref": "#/definitions/postgresRoleIdentifier"},
        "tls": {
          "type": "object",
          "additionalProperties": false,
          "required": ["mode", "caSecret"],
          "properties": {
            "mode": {"type": "string", "enum": ["disable", "require", "verify-ca", "verify-full"]},
            "caSecret": {"$ref": "#/definitions/secretReference"}
          }
        },
        "administrationSecret": {"$ref": "#/definitions/secretReference"},
        "migrationSecret": {"$ref": "#/definitions/secretReference"},
        "initializerSecret": {"$ref": "#/definitions/secretReference"},
        "runtimeSecret": {"$ref": "#/definitions/secretReference"},
        "keycloakSecret": {"$ref": "#/definitions/secretReference"}
      }
    },
    "postgresIdentifier": {"type": "string", "pattern": "^[a-z_][a-z0-9_]{0,62}$"},
    "postgresRoleIdentifier": {
      "allOf": [
        {"$ref": "#/definitions/postgresIdentifier"},
        {"not": {"enum": ["postgres", "public"]}},
        {"not": {"pattern": "^pg_"}}
      ]
    },
    "postgresDatabaseIdentifier": {
      "allOf": [
        {"$ref": "#/definitions/postgresIdentifier"},
        {"not": {"enum": ["postgres", "template0", "template1"]}}
      ]
    },
    "enabledMode": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled"],
      "properties": {"enabled": {"type": "boolean"}}
    },
    "containerImage": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "tag", "digest", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1, "not": {"enum": ["latest"]}},
        "digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "identityUser": {
      "type": "object",
      "additionalProperties": false,
      "required": ["subject", "username"],
      "properties": {
        "subject": {"type": "string", "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-5][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"},
        "username": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,62}$"}
      }
    },
    "bundledIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "image", "hostname", "realm", "audience", "client", "accessTokenLifespanSeconds", "jwksCacheMaxAgeSeconds", "tokenFixture", "credentialsSecret", "users", "resources"],
      "properties": {
        "enabled": {"type": "boolean"},
        "image": {"$ref": "#/definitions/containerImage"},
        "hostname": {"type": "string", "pattern": "^https://[^/]+$"},
        "realm": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,62}$"},
        "audience": {"type": "string", "minLength": 1},
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "redirectURIs", "webOrigins"],
          "properties": {
            "id": {"type": "string", "pattern": "^[a-z][a-z0-9._-]{0,62}$"},
            "redirectURIs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://.+"}},
            "webOrigins": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "pattern": "^https://[^/]+$"}}
          }
        },
        "accessTokenLifespanSeconds": {"type": "integer", "minimum": 60, "maximum": 900},
        "jwksCacheMaxAgeSeconds": {"type": "integer", "minimum": 1, "maximum": 900},
        "tokenFixture": {
          "type": "object",
          "additionalProperties": false,
          "required": ["enabled"],
          "properties": {"enabled": {"type": "boolean"}}
        },
        "credentialsSecret": {
          "type": "object",
          "additionalProperties": false,
          "required": ["existingName"],
          "properties": {"existingName": {"type": "string"}}
        },
        "users": {
          "type": "object",
          "additionalProperties": false,
          "required": ["owner", "other"],
          "properties": {
            "owner": {"$ref": "#/definitions/identityUser"},
            "other": {"$ref": "#/definitions/identityUser"}
          }
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "required": ["requests", "limits"],
          "properties": {
            "requests": {"$ref": "#/definitions/resourceList"},
            "limits": {"$ref": "#/definitions/resourceList"}
          }
        }
      }
    },
    "externalIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "client"],
      "properties": {
        "enabled": {"type": "boolean"},
        "client": {
          "type": "object",
          "additionalProperties": false,
          "required": ["id", "secret"],
          "properties": {
            "id": {"type": "string"},
            "secret": {"$ref": "#/definitions/secretReference"}
          }
        }
      }
    },
    "resourceList": {
      "type": "object",
      "additionalProperties": false,
      "required": ["cpu", "memory"],
      "properties": {
        "cpu": {"type": "string", "minLength": 1},
        "memory": {"type": "string", "minLength": 1}
      }
    }
  }
}
